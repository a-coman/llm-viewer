---
import {
  getColor,
  getBinaryColor,
  formatPercent,
  formatCurrency,
} from "../lib/utils";
import { COLOR_RANGES, INFINITY_SYMBOL } from "../lib/constants";
import Tooltip from "./Tooltip.astro";
interface MetricStat {
  errors: number;
  total: number;
}

interface InstantiationValueItem {
  value: number;
  total: number | null; // null = infinity
}

interface InstantiationItem {
  classes: InstantiationValueItem;
  attributes: InstantiationValueItem;
  relationships: InstantiationValueItem;
}

interface CoverageUncoveredItem {
  classes: string[];
  attributes: string[];
  relationships: string[];
}

interface Metrics {
  syntax?: number | MetricStat;
  multiplicities?: number | MetricStat;
  invariants?: number | MetricStat;
  coverage?: {
    coverage: { classes: number; attributes: number; relationships: number };
    instantiation: InstantiationItem;
    uncovered?: CoverageUncoveredItem;
  };
  diversity?: {
    numeric: number;
    stringEquals: number;
    stringLv: number;
    ged?: { mean: number; std: number };
    shannon?: { mean: number; std: number };
    shannonActive?: number;
    shannonAll?: number;
    shannonActiveStd?: number;
    shannonAllStd?: number;
  };
  judge?: {
    successRate: number;
    price?: { price: number };
    elapsedSeconds?: number;
    time_seconds?: number;
  };
  price?: { price: number };
  elapsedSeconds?: number;
  time_seconds?: number;
  instantiation?: InstantiationItem;
  realism?: number;
}

interface Props {
  title?: string;
  metrics: Metrics | any;
  showSections?: {
    cost?: boolean;
    validation?: boolean;
    coverage?: boolean;
    instantiation?: boolean;
    diversity?: boolean;
    quality?: boolean;
  };
  isInvalidCategory?: boolean;
  priceRange?: { green: number; red: number };
  defaultExpanded?: boolean;
}

const {
  metrics,
  title,
  showSections = {
    cost: true,
    validation: true,
    coverage: true,
    instantiation: true,
    diversity: true,
    quality: false,
  },
  isInvalidCategory = false,
  priceRange = COLOR_RANGES.price.summary,
  defaultExpanded = true,
} = Astro.props;

function shouldInvertInvalidMetric(metricKey: string): boolean {
  return metricKey === "multiplicities" || metricKey === "invariants";
}

interface DisplayValue {
  text: string;
  style: string;
  isToggleable?: boolean;
  rawText?: string;
}

function getDisplayValue(
  val: any,
  type: "percent" | "count" | "currency" = "percent",
  metricKey: string = "",
): DisplayValue {
  if (val === undefined || val === null) return { text: "—", style: "" };

  if (type === "currency") {
    const price = typeof val === "object" ? val.price : val;
    return {
      text: formatCurrency(price),
      style: getColor(price, priceRange.green, priceRange.red),
    };
  }

  if (typeof val === "object") {
    if ("errors" in val) {
      // For "invalid" category: only multiplicities/invariants are inverted
      // (errors expected = green), all other metrics stay normal.
      const shouldInvert =
        isInvalidCategory && shouldInvertInvalidMetric(metricKey);
      
      // Compute success fraction
      const success = val.total - val.errors;
      const rate = val.total > 0 ? success / val.total : 1;
      
      const colorVal = shouldInvert ? 1 - rate : rate;

      return {
        text: formatPercent(rate),
        rawText: `${success}/${val.total}`,
        style: getColor(
          colorVal,
          COLOR_RANGES.validation.percent.green,
          COLOR_RANGES.validation.percent.red
        ),
        isToggleable: true
      };
    }

    if ("realistic" in val && typeof val.realistic === "number") {
      const total = val.realistic + val.unrealistic + (val.unknown || val.doubtful || 0);
      const rate = total > 0 ? val.realistic / total : 0;
      return {
        text: formatPercent(rate),
        rawText: `${val.realistic}/${total}`,
        style: getColor(rate, COLOR_RANGES.validation.percent.green, COLOR_RANGES.validation.percent.red),
        isToggleable: true
      };
    }

    if ("value" in val) {
      const v = Math.round(val.value);
      if (val.total === null) {
        return {
          text: `${v}/${INFINITY_SYMBOL}`,
          style: getBinaryColor(true),
        };
      }
      const t = Math.round(val.total);
      const ratio = t > 0 ? v / t : 1;
      return {
        text: formatPercent(ratio),
        rawText: `${v}/${t}`,
        style: getColor(ratio, COLOR_RANGES.validation.percent.green, COLOR_RANGES.validation.percent.red),
        isToggleable: true
      };
    }

    if ("successRate" in val && typeof val.successRate === "number") {
      return {
        text: formatPercent(val.successRate),
        style: getColor(val.successRate, COLOR_RANGES.validation.percent.green, COLOR_RANGES.validation.percent.red),
      };
    }
  }

  if (typeof val === "number") {
    if (type === "count")
      return { text: Math.round(val).toString(), style: "" };
    // For percentages: use gradient (green = 100%, red = 0%).
    // In invalid category, invert only multiplicities/invariants.
    const shouldInvert =
      isInvalidCategory && shouldInvertInvalidMetric(metricKey);
    const colorVal = shouldInvert ? 1 - val : val;
    return {
      text: formatPercent(val),
      style: getColor(
        colorVal,
        COLOR_RANGES.validation.percent.green,
        COLOR_RANGES.validation.percent.red,
      ),
    };
  }

  return { text: "—", style: "" };
}

// Helper for instantiation display: value/total or value/∞
function getInstantiationDisplay(
  item: InstantiationValueItem | undefined,
  key: string,
): DisplayValue {
  if (!item || item.value === undefined) return { text: "—", style: "" };

  const value = Math.round(item.value);
  const total = item.total;

  if (total === null) {
    // Infinity case (classes/relationships) - always green
    return {
      text: `${value}/${INFINITY_SYMBOL}`,
      style: getBinaryColor(true),
    };
  }

  // Has a finite total (attributes) - use percentage coloring
  const totalRound = Math.round(total);
  const ratio = totalRound > 0 ? value / totalRound : 1;
  return {
    text: formatPercent(ratio),
    rawText: `${value}/${totalRound}`,
    style: getColor(
      ratio,
      COLOR_RANGES.validation.percent.green,
      COLOR_RANGES.validation.percent.red,
    ),
    isToggleable: true
  };
}

function formatElapsedSeconds(value: number | undefined | null): string {
  if (value === undefined || value === null || isNaN(value)) return "—";
  const totalSeconds = Number(value);
  if (totalSeconds < 60) return `${totalSeconds.toFixed(2)}s`;

  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = totalSeconds % 60;

  if (hours > 0) return `${hours}h ${minutes}m ${seconds.toFixed(1)}s`;
  return `${minutes}m ${seconds.toFixed(1)}s`;
}

function formatDecimal(value: number | undefined | null): string {
  if (value === undefined || value === null || isNaN(value)) return "—";
  return value.toFixed(3);
}

const cov = metrics?.coverage?.coverage || metrics?.coverage;
const inst = metrics?.coverage?.instantiation || metrics?.instantiation;
const uncovered: CoverageUncoveredItem | undefined =
  metrics?.coverage?.uncovered || metrics?.uncovered;
const uncoveredEntries: Array<[keyof CoverageUncoveredItem, string[]]> =
  uncovered
    ? (
        Object.entries(uncovered) as Array<
          [keyof CoverageUncoveredItem, string[]]
        >
      ).filter(([, values]) => Array.isArray(values) && values.length > 0)
    : [];
const UNCOVERED_PREVIEW_LIMIT = 8;
const totalUncovered = uncoveredEntries.reduce(
  (sum, [, values]) => sum + values.length,
  0,
);
const div = metrics?.diversity;
const judge = metrics?.judge || { successRate: metrics?.realism };
const price = metrics?.price;
//const elapsedSeconds = metrics?.elapsedSeconds ?? metrics?.time_seconds;
const elapsedSeconds = undefined; // Temporarily hide elapsed time
const judgePrice = judge?.price;
//const judgeElapsedSeconds = judge?.elapsedSeconds ?? judge?.time_seconds;
const judgeElapsedSeconds = undefined; // Temporarily hide elapsed time
---

<details class="metrics-panel" open={defaultExpanded}>
  {title && <summary class="sober-header panel-header">{title}</summary>}

  {
    showSections.cost &&
      (price !== undefined ||
        metrics?.cost !== undefined ||
        elapsedSeconds !== undefined) && (
        <details
          class="metric-section metric-panel-details"
          open={defaultExpanded}
        >
          <summary class="sober-label">
            Stats
            <Tooltip metricType="cost" />
          </summary>

          <table class="metrics-table">
            <tbody>
              {elapsedSeconds !== undefined && (
                <tr>
                  <td>Elapsed Time</td>
                  <td>{formatElapsedSeconds(elapsedSeconds)}</td>
                </tr>
              )}

              {(price !== undefined || metrics?.cost !== undefined) && (
                <tr>
                  <td>Total Cost</td>
                  <td
                    style={
                      getDisplayValue(price ?? metrics?.cost, "currency").style
                    }
                  >
                    {getDisplayValue(price ?? metrics?.cost, "currency").text}
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </details>
      )
  }

  {
    showSections.validation && (
      <details
        class="metric-section metric-panel-details"
        open={defaultExpanded}
      >
        <summary class="sober-label">
          Validation
          <Tooltip metricType="validation" />
        </summary>

        <table class="metrics-table">
          <tbody>
            {["syntax", "multiplicities", "invariants"].map((key) => {
              // Check both root level and nested metrics.metrics level
              const val = metrics?.[key] ?? metrics?.metrics?.[key];
              const { text, style, isToggleable, rawText } = getDisplayValue(val, "percent", key);
              const label = key.charAt(0).toUpperCase() + key.slice(1);
              return (
                <tr>
                  <td>{label}</td>
                  <td style={style}>
                    {isToggleable ? (
                      <span class="value-toggle" title="Click to toggle display format">
                        <span class="view-default">{text}</span>
                        <span class="view-raw" style="display: none;">{rawText}</span>
                      </span>
                    ) : (
                      text
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </details>
    )
  }

  {
    showSections.diversity && div && (
      <details
        class="metric-section metric-panel-details"
        open={defaultExpanded}
      >
        <summary class="sober-label">
          Diversity
          <Tooltip metricType="diversity" />
        </summary>

        <table class="metrics-table">
          <tbody>
            <tr>
              <td>Numeric</td>
              <td style={getDisplayValue(div.numeric).style}>
                {getDisplayValue(div.numeric).text}
              </td>
            </tr>
            <tr>
              <td>String Equals</td>
              <td style={getDisplayValue(div.stringEquals).style}>
                {getDisplayValue(div.stringEquals).text}
              </td>
            </tr>
            <tr>
              <td>String LV</td>
              <td style={getDisplayValue(div.stringLv).style}>
                {getDisplayValue(div.stringLv).text}
              </td>
            </tr>
            {div.ged && (
              <tr>
                <td>GED</td>
                <td style={getColor(div.ged.mean, 0.5, 0.9)}>
                  {div.ged.mean.toFixed(3)} ± {div.ged.std.toFixed(3)}
                </td>
              </tr>
            )}
            {div.shannon && (
              <tr>
                <td>Shannon</td>
                <td style={getColor(div.shannon.mean, 1, 0)}>
                  {div.shannon.mean.toFixed(3)} ± {div.shannon.std.toFixed(3)}
                </td>
              </tr>
            )}
            {div.shannonActive !== undefined && (
              <tr>
                <td>Shannon (Active)</td>
                <td style={getColor(div.shannonActive, 1, 0)}>
                  {formatDecimal(div.shannonActive)}
                  {div.shannonActiveStd !== undefined &&
                    ` ± ${formatDecimal(div.shannonActiveStd)}`}
                </td>
              </tr>
            )}
            {div.shannonAll !== undefined && (
              <tr>
                <td>Shannon (All)</td>
                <td style={getColor(div.shannonAll, 1, 0)}>
                  {formatDecimal(div.shannonAll)}
                  {div.shannonAllStd !== undefined &&
                    ` ± ${formatDecimal(div.shannonAllStd)}`}
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </details>
    )
  }

  {
    showSections.coverage && cov && (
      <details
        class="metric-section metric-panel-details"
        open={defaultExpanded}
      >
        <summary class="sober-label">
          Coverage
          <Tooltip metricType="coverage" />
        </summary>

        <table class="metrics-table">
          <tbody>
            {Object.entries(cov).map(([key, val]) => {
              const { text, style, isToggleable, rawText } = getDisplayValue(val);
              const label = key.charAt(0).toUpperCase() + key.slice(1);
              return (
                <tr>
                  <td>{label}</td>
                  <td style={style}>
                    {isToggleable ? (
                      <span class="value-toggle" title="Click to toggle display format">
                        <span class="view-default">{text}</span>
                        <span class="view-raw" style="display: none;">{rawText}</span>
                      </span>
                    ) : (
                      text
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>

        {uncoveredEntries.length > 0 && (
          <details class="coverage-uncovered">
            <summary class="sober-label coverage-uncovered-header">
              <span>Uncovered Items</span>
              <span class="sober-count-badge coverage-uncovered-total">
                {totalUncovered}
              </span>
            </summary>

            <div class="coverage-uncovered-grid">
              {uncoveredEntries.map(([key, values]) => {
                const label = key.charAt(0).toUpperCase() + key.slice(1);
                const preview = values.slice(0, UNCOVERED_PREVIEW_LIMIT);
                const hasMore = values.length > UNCOVERED_PREVIEW_LIMIT;
                return (
                  <section class="coverage-uncovered-group">
                    <div class="coverage-uncovered-group-head">
                      <span class="coverage-uncovered-group-label">
                        {label}
                      </span>
                      <span class="sober-count-badge coverage-uncovered-count">
                        {values.length}
                      </span>
                    </div>

                    <div class="coverage-uncovered-chips">
                      {preview.map((item) => (
                        <span class="coverage-chip">{item}</span>
                      ))}
                    </div>

                    {hasMore && (
                      <details class="coverage-uncovered-more">
                        <summary>
                          Show all {values.length} {label.toLowerCase()}
                        </summary>
                        <div class="coverage-uncovered-chips all">
                          {values.map((item) => (
                            <span class="coverage-chip">{item}</span>
                          ))}
                        </div>
                      </details>
                    )}
                  </section>
                );
              })}
            </div>
          </details>
        )}
      </details>
    )
  }

  {
    showSections.instantiation && inst && (
      <details
        class="metric-section metric-panel-details"
        open={defaultExpanded}
      >
        <summary class="sober-label">
          Instantiation
          <Tooltip metricType="instantiation" />
        </summary>

        <table class="metrics-table">
          <tbody>
            {Object.entries(inst).map(([key, val]) => {
              const { text, style, isToggleable, rawText } = getInstantiationDisplay(
                val as InstantiationValueItem,
                key,
              );
              const label = key.charAt(0).toUpperCase() + key.slice(1);
              return (
                <tr>
                  <td>{label}</td>
                  <td style={style}>
                    {isToggleable ? (
                      <span class="value-toggle" title="Click to toggle display format">
                        <span class="view-default">{text}</span>
                        <span class="view-raw" style="display: none;">{rawText}</span>
                      </span>
                    ) : (
                      text
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </details>
    )
  }

  {
    showSections.quality && judge && (
      <details
        class="metric-section metric-panel-details"
        open={defaultExpanded}
      >
        <summary class="sober-label">
          Quality
          <Tooltip metricType="realism" />
        </summary>

        <table class="metrics-table">
          <tbody>
            <tr>
              <td>Realism</td>
              <td style={getDisplayValue(judge).style}>
                {getDisplayValue(judge).isToggleable ? (
                  <span class="value-toggle" title="Click to toggle display format">
                    <span class="view-default">{getDisplayValue(judge).text}</span>
                    <span class="view-raw" style="display: none;">{getDisplayValue(judge).rawText}</span>
                  </span>
                ) : (
                  getDisplayValue(judge).text
                )}
              </td>
            </tr>
            {judgePrice !== undefined && (
              <tr>
                <td>Judge Cost</td>
                <td style={getDisplayValue(judgePrice, "currency").style}>
                  {getDisplayValue(judgePrice, "currency").text}
                </td>
              </tr>
            )}
            {judgeElapsedSeconds !== undefined && (
              <tr>
                <td>Judge Elapsed Time</td>
                <td>{formatElapsedSeconds(judgeElapsedSeconds)}</td>
              </tr>
            )}
          </tbody>
        </table>
      </details>
    )
  }
</details>

<style>
  .metrics-panel {
    background: var(--color-background);
    border: 1px solid var(--color-border);
  }

  .metric-section {
    border-top: 1px solid var(--color-border);
  }

  .metric-section:first-of-type {
    border-top: none;
  }

  .metrics-table {
    margin: 0;
  }

  .coverage-uncovered {
    border-top: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .coverage-uncovered-header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    margin: 0;
    padding-right: 7.25rem;
  }

  .coverage-uncovered-header::after {
    width: 6.5rem;
    text-align: right;
    right: 0.75rem;
  }

  .coverage-uncovered-total {
    margin-left: 0.25rem;
  }

  .coverage-uncovered-group {
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-background);
    padding: 0.45rem;
  }

  .coverage-uncovered-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
    padding: 0.65rem 0.75rem 0.8rem;
  }

  .coverage-uncovered-group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }

  .coverage-uncovered-group-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .coverage-uncovered-count {
    color: var(--color-text-secondary);
  }

  .coverage-uncovered-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .coverage-chip {
    font-size: 0.75rem;
    line-height: 1.25;
    color: var(--color-secondary);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.1rem 0.45rem;
    background: var(--color-surface);
    word-break: break-word;
    max-width: 100%;
  }

  .coverage-uncovered-more {
    margin-top: 0.4rem;
  }

  .coverage-uncovered-more summary {
    cursor: pointer;
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    user-select: none;
  }

  .coverage-uncovered-chips.all {
    margin-top: 0.35rem;
  }

  /* Value Toggle Indicator */
  .value-toggle {
    cursor: pointer;
    text-decoration: underline dashed;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border);
  }
  .value-toggle:hover {
    text-decoration-color: var(--color-secondary);
  }
</style>

<script>
  function setupToggles() {
    const toggles = document.querySelectorAll('.metrics-panel .value-toggle');
    toggles.forEach(toggle => {
      // Clean up old listeners by replacing node
      const parent = toggle.parentNode;
      if (parent) {
        const clone = toggle.cloneNode(true);
        parent.replaceChild(clone, toggle);
      }
    });

    document.querySelectorAll('.metrics-panel .value-toggle').forEach(toggle => {
      toggle.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLElement;
        const defaultView = el.querySelector('.view-default') as HTMLElement;
        const rawView = el.querySelector('.view-raw') as HTMLElement;
        if (defaultView && rawView) {
          if (defaultView.style.display === 'none') {
            defaultView.style.display = 'inline';
            rawView.style.display = 'none';
          } else {
            defaultView.style.display = 'none';
            rawView.style.display = 'inline';
          }
        }
      });
    });
  }

  setupToggles();
  document.addEventListener('astro:page-load', setupToggles);
</script>
