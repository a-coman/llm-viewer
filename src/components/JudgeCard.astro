---
interface Props {
  response?: "Realistic" | "Unrealistic" | "Unknown" | "Doubtful" | string;
  why?: string;
  defaultExpanded?: boolean;
}

const { response = "Unknown", why, defaultExpanded = false } = Astro.props;

// Normalize response casing for comparison (handles lowercase from JSON)
const normalizedResponse = response?.toLowerCase() || "unknown";

const badgeClass =
  normalizedResponse === "realistic"
    ? "badge-success"
    : normalizedResponse === "unrealistic"
      ? "badge-error"
      : "badge-unknown";

// Capitalize first letter for display
const displayResponse = response
  ? response.charAt(0).toUpperCase() + response.slice(1).toLowerCase()
  : "Unknown";
---

<details class="judge-card" open={defaultExpanded}>
  <summary class="sober-header judge-summary">
    <span class="title">LLM as a Judge</span>
  </summary>

  <div class="judge-content">
    <div class="badge-wrapper">
      <span class={`badge ${badgeClass}`}>{displayResponse}</span>
    </div>
    {
      why && (
        <div class="why">
          <p class="why-text">{why}</p>
        </div>
      )
    }
  </div>
</details>

<style>
  .judge-card {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  .judge-summary {
    cursor: pointer;
    user-select: none;
    justify-content: space-between;
  }

  .judge-summary:hover {
    background: var(--color-surface);
  }

  .judge-content {
    display: flex;
    flex-direction: column;
  }

  .badge-wrapper {
    padding: 0.75rem 1rem 0 1rem;
  }

  .badge {
    padding: 0.2rem 0.6rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  .badge-success {
    background: var(--color-success-bg);
    color: var(--color-primary);
    border: 1px solid var(--color-success-border);
  }

  .badge-error {
    background: var(--color-error-bg);
    color: var(--color-primary);
    border: 1px solid var(--color-error-border);
  }

  .badge-unknown {
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
    border: 1px solid var(--color-warning-border);
  }

  .why {
    padding: 0.75rem 1rem;
    background: var(--color-background);
  }

  .why-text {
    font-size: 0.8rem;
    color: var(--color-secondary);
    line-height: 1.5;
    margin: 0;
  }
</style>
