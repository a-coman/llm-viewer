---
interface ShannonEntry {
  name: string;
  values: Record<string, number>;
  shannon: {
    eveness_active_groups: number;
    eveness_all_groups: number;
  };
}

interface Props {
  data: ShannonEntry[];
  title?: string;
}

import { getColor } from "../lib/utils";

const { data, title } = Astro.props;

function getMaxValue(values: Record<string, number>): number {
  const allValues = Object.values(values || {});
  if (allValues.length === 0) return 1;
  return Math.max(...allValues, 1);
}

function getScaleStep(maxValue: number): number {
  if (maxValue <= 10) return 2;
  if (maxValue <= 50) return 5;
  if (maxValue <= 100) return 10;
  if (maxValue <= 250) return 25;
  if (maxValue <= 500) return 50;
  return 100;
}

function getScaleMax(maxValue: number, step: number): number {
  if (maxValue <= 0) return step;
  const roundedUp = Math.ceil(maxValue / step) * step;
  return roundedUp === maxValue ? roundedUp + step : roundedUp;
}

function getYAxisTicks(scaleMax: number, step: number): number[] {
  const ticks: number[] = [];
  for (let tick = scaleMax; tick >= 0; tick -= step) {
    ticks.push(tick);
  }
  if (ticks[ticks.length - 1] !== 0) ticks.push(0);
  return ticks;
}
---

<div class="shannon-container">
  {title && <h3 class="sober-header">{title}</h3>}

  {
    data.length === 0 ? (
      <div class="sober-empty-state">
        <span class="sober-empty-text">No Shannon data</span>
      </div>
    ) : (
      <div class="shannon-list">
        {data.map((entry) => (
          <div class="shannon-card">
            <div class="shannon-title">{entry.name}</div>
            <div class="shannon-subtitle">
              <span>
                Evenness (active groups) =
                {entry.shannon.eveness_active_groups.toFixed(4)}
              </span>
              <span>
                Evenness (all groups) ={" "}
                {entry.shannon.eveness_all_groups.toFixed(4)}
              </span>
            </div>

            {(() => {
              const observedMax = getMaxValue(entry.values);
              const scaleStep = getScaleStep(observedMax);
              const scaleMax = getScaleMax(observedMax, scaleStep);
              const yAxisTicks = getYAxisTicks(scaleMax, scaleStep);

              return (
                <div class="bar-chart-shell">
                  <div class="y-axis" aria-hidden="true">
                    {yAxisTicks.map((tick) => (
                      <div class="y-axis-tick-row">
                        <div class="y-axis-tick">{tick}</div>
                      </div>
                    ))}
                  </div>

                  <div class="bar-chart">
                    <div class="y-grid-lines" aria-hidden="true">
                      {yAxisTicks.map(() => (
                        <div class="y-grid-line" />
                      ))}
                    </div>
                    {Object.entries(entry.values).map(([value, count]) => {
                      const heightPercent = (count / scaleMax) * 100;

                      return (
                        <div class="bar-column">
                          <div class="bar-track">
                            <div
                              class="bar-fill"
                              style={`height: ${heightPercent}%; ${getColor(
                                entry.shannon.eveness_all_groups,
                                0.9,
                                0,
                              )}`}
                            >
                              <span class="bar-number">{count}</span>
                            </div>
                          </div>
                          <span class="bar-label" title={value}>
                            {value}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })()}
          </div>
        ))}
      </div>
    )
  }
</div>
