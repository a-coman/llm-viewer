---
import PageLayout from "../../../layouts/PageLayout.astro";
import GedHeatmap from "../../../components/GedHeatmap.astro";
import ShannonBars from "../../../components/ShannonBars.astro";
import DataTable from "../../../components/DataTable.astro";
import MetricsPanel from "../../../components/MetricsPanel.astro";
import { MODELS_LOWER, COLOR_RANGES } from "../../../lib/constants";
import { getModelName } from "../../../lib/utils";
import { getModelData, getExperimentIds } from "../../../lib/data";

export async function getStaticPaths() {
  const experimentIds = getExperimentIds();
  const paths: { params: { experiment: string; model: string } }[] = [];
  for (const experiment of experimentIds) {
    for (const model of MODELS_LOWER) {
      paths.push({ params: { experiment, model } });
    }
  }
  return paths;
}

const { experiment, model } = Astro.params;
const modelName = getModelName(model || "");
const experimentIds = getExperimentIds();

const modelData = getModelData(model || "", experiment);

const simpleData = modelData?.simple || null;
const cotData = modelData?.cot || null;

const modelPanelSections = {
  cost: true,
  validation: true,
  coverage: true,
  instantiation: true,
  diversity: true,
  quality: true,
};
---

<PageLayout
  title={modelName}
  currentModel={modelName}
  currentPage="model"
  activeTab="simple"
  experimentId={experiment}
  experimentIds={experimentIds}
>
  {
    !modelData ? (
      <div class="error-state">
        <p>
          No data available for model: <strong>{modelName}</strong>
        </p>
      </div>
    ) : (
      <>
        <div class="tab-content active" data-content="simple">
          <div class="content-grid">
            <details class="section" open>
              <summary class="sober-header">GED / Shannon</summary>
              <div class="diagram-header sober-label">
                <div class="viz-switch" data-viz-switch>
                  <button
                    class="viz-btn active"
                    data-viz-target="ged"
                    type="button"
                  >
                    GED
                  </button>
                  <button
                    class="viz-btn"
                    data-viz-target="shannon"
                    type="button"
                  >
                    Shannon
                  </button>
                </div>
              </div>

              <div class="viz-panel active" data-viz-content="ged">
                {simpleData?.gedHeatmap ? (
                  <GedHeatmap data={simpleData.gedHeatmap} />
                ) : (
                  <div class="sober-empty-state">
                    <span class="sober-empty-text">No GED Data</span>
                  </div>
                )}
              </div>

              <div class="viz-panel" data-viz-content="shannon">
                {simpleData?.shannon?.length ? (
                  <ShannonBars data={simpleData.shannon} />
                ) : (
                  <div class="sober-empty-state">
                    <span class="sober-empty-text">
                      No Shannon Data for this model
                    </span>
                    <span class="sober-empty-hint">
                      Available: AddressBook, Football, MyExpenses, PickupNet,
                      Restaurant, VehicleRental, VideoClub
                    </span>
                  </div>
                )}
              </div>
            </details>

            <div class="metrics-column">
              <MetricsPanel
                title={`${modelName} - Simple Metrics`}
                metrics={simpleData}
                showSections={modelPanelSections}
                priceRange={COLOR_RANGES.price.model}
              />
            </div>
          </div>

          <details class="section" open>
            <summary class="sober-header">Generations</summary>
            {simpleData?.generations ? (
              <DataTable
                data={simpleData.generations}
                type="generations"
                modelSlug={model}
                experimentId={experiment}
              />
            ) : (
              <p class="no-data">No generation data available</p>
            )}
          </details>
        </div>

        <div class="tab-content" data-content="cot">
          <div class="content-grid">
            <details class="section" open>
              <summary class="sober-header">GED / Shannon</summary>
              <div class="diagram-header sober-label">
                <div class="viz-switch" data-viz-switch>
                  <button
                    class="viz-btn active"
                    data-viz-target="ged"
                    type="button"
                  >
                    GED
                  </button>
                  <button
                    class="viz-btn"
                    data-viz-target="shannon"
                    type="button"
                  >
                    Shannon
                  </button>
                </div>
              </div>

              <div class="viz-panel active" data-viz-content="ged">
                {cotData?.gedHeatmap ? (
                  <GedHeatmap data={cotData.gedHeatmap} />
                ) : (
                  <div class="sober-empty-state">
                    <span class="sober-empty-text">No GED Data</span>
                  </div>
                )}
              </div>

              <div class="viz-panel" data-viz-content="shannon">
                {cotData?.shannon?.length ? (
                  <ShannonBars data={cotData.shannon} />
                ) : (
                  <div class="sober-empty-state">
                    <span class="sober-empty-text">
                      No Shannon Data for this model
                    </span>
                    <span class="sober-empty-hint">
                      Available: AddressBook, Football, MyExpenses, PickupNet,
                      Restaurant, VehicleRental, VideoClub
                    </span>
                  </div>
                )}
              </div>
            </details>

            <div class="metrics-column">
              <MetricsPanel
                title={`${modelName} - CoT Metrics`}
                metrics={cotData}
                showSections={modelPanelSections}
                priceRange={COLOR_RANGES.price.model}
              />
            </div>
          </div>

          <details class="section" open>
            <summary class="sober-header">Generations</summary>
            {cotData?.generations ? (
              <DataTable
                data={cotData.generations}
                type="generations"
                modelSlug={model}
                genType="cot"
                experimentId={experiment}
              />
            ) : (
              <p class="no-data">No generation data available</p>
            )}
          </details>
        </div>
      </>
    )
  }
</PageLayout>

<script>
  import { QUERY_MODES, QUERY_VIEWS } from "../../../lib/constants";
  import { getViewerState, applyViewerQueryToUrl } from "../../../lib/query";

  document.addEventListener("DOMContentLoaded", () => {
    const modeBtns = document.querySelectorAll(".mode-btn");
    const contents = document.querySelectorAll(".tab-content[data-content]");
    const initialState = getViewerState(window.location.search);
    const initialTab = initialState.mode;
    const initialViz =
      initialState.view === QUERY_VIEWS.shannonGraph ? "shannon" : "ged";

    function setTab(tabName: string) {
      document.documentElement.setAttribute("data-mode", tabName);
      modeBtns.forEach((btn) =>
        btn.classList.toggle(
          "active",
          btn.getAttribute("data-mode") === tabName,
        ),
      );
      contents.forEach((c) =>
        c.classList.toggle(
          "active",
          c.getAttribute("data-content") === tabName,
        ),
      );
      const url = new URL(window.location.href);
      applyViewerQueryToUrl(url, {
        mode: tabName as (typeof QUERY_MODES)[keyof typeof QUERY_MODES],
      });
      window.history.replaceState({}, "", url.toString());
    }

    setTab(initialTab);
    modeBtns.forEach((btn) =>
      btn.addEventListener("click", () =>
        setTab(btn.getAttribute("data-mode") || QUERY_MODES.simple),
      ),
    );

    document.querySelectorAll("[data-viz-switch]").forEach((switchRoot) => {
      const root = switchRoot.closest(".section");
      if (!root) return;

      const buttons = switchRoot.querySelectorAll("[data-viz-target]");
      const panels = root.querySelectorAll("[data-viz-content]");

      const setViz = (target: string, updateUrl = true) => {
        document.documentElement.setAttribute("data-viz", target);

        buttons.forEach((btn) =>
          btn.classList.toggle(
            "active",
            btn.getAttribute("data-viz-target") === target,
          ),
        );
        panels.forEach((panel) =>
          panel.classList.toggle(
            "active",
            panel.getAttribute("data-viz-content") === target,
          ),
        );

        if (updateUrl) {
          const url = new URL(window.location.href);
          applyViewerQueryToUrl(url, {
            view:
              target === "shannon"
                ? QUERY_VIEWS.shannonGraph
                : QUERY_VIEWS.instanceDiagram,
          });
          window.history.replaceState({}, "", url.toString());
        }
      };

      setViz(initialViz, false);
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.getAttribute("data-viz-target") || "ged";
          setViz(target, true);
        });
      });
    });
  });
</script>

<style>
  .content-grid {
    grid-template-columns: max-content 1fr;
  }

  @media (max-width: 1024px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }

  .content-grid > * {
    height: auto;
  }

  .content-grid {
    align-items: start;
  }

  .metrics-column {
    align-self: start;
  }

  .metrics-column :global(.metrics-panel) {
    height: auto;
  }
</style>
