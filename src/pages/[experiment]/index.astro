---
import PageLayout from "../../layouts/PageLayout.astro";
import DataTable from "../../components/DataTable.astro";
import MetricsPanel from "../../components/MetricsPanel.astro";
import { getDashboardData, getExperimentIds } from "../../lib/data";

export async function getStaticPaths() {
  const experimentIds = getExperimentIds();
  return experimentIds.map((experiment) => ({ params: { experiment } }));
}

const { experiment } = Astro.params;
const dashboardData = getDashboardData(experiment);
const { totals, models } = dashboardData || {};

const experimentIds = getExperimentIds();

const summarySections = {
  cost: true,
  validation: true,
  coverage: true,
  instantiation: true,
  diversity: true,
  quality: true,
};
---

<PageLayout
  title="Dashboard"
  currentPage="dashboard"
  activeTab="simple"
  experimentId={experiment}
  experimentIds={experimentIds}
>
  {
    !dashboardData ? (
      <div class="error-state">
        <p>No data available.</p>
      </div>
    ) : (
      <>
        <details class="section" open>
          <summary class="sober-header">Global Summary</summary>
          <div class="summary-grid">
            <MetricsPanel
              title="Simple"
              metrics={totals.simple}
              showSections={summarySections}
            />
            <MetricsPanel
              title="CoT"
              metrics={totals.cot}
              showSections={summarySections}
            />
          </div>
        </details>

        <details class="section" open>
          <summary class="sober-header">Simple - Model Comparison</summary>
          <DataTable
            data={models}
            type="models"
            mode="simple"
            experimentId={experiment}
          />
        </details>

        <details class="section" open>
          <summary class="sober-header">CoT - Model Comparison</summary>
          <DataTable
            data={models}
            type="models"
            mode="cot"
            experimentId={experiment}
          />
        </details>
      </>
    )
  }
</PageLayout>

<style>
  .section {
    display: flex;
    flex-direction: column;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    padding: 0.25rem;
  }
</style>
