---
import "../styles/global.css";
import { getUrl } from "../lib/utils";
import { QUERY_KEYS, QUERY_MODES, QUERY_VIEWS } from "../lib/constants";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={getUrl("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <title>LLM Viewer</title>
    <script
      is:inline
      define:vars={{
        queryModeKey: QUERY_KEYS.mode,
        queryViewKey: QUERY_KEYS.view,
        modeCot: QUERY_MODES.cot,
        modeSimple: QUERY_MODES.simple,
        shannonView: QUERY_VIEWS.shannonGraph,
      }}
    >
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var type = params.get(queryModeKey);
          var view = params.get(queryViewKey);
          if (type === modeCot) {
            document.documentElement.setAttribute("data-mode", modeCot);
          } else {
            document.documentElement.setAttribute("data-mode", modeSimple);
          }

          if (view === shannonView) {
            document.documentElement.setAttribute("data-viz", "shannon");
          } else {
            document.documentElement.setAttribute("data-viz", "ged");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div
      id="error-overlay"
      style="display:none; position:fixed; top:0; left:0; width:100%; background:red; color:white; padding:10px; z-index:9999;"
    >
    </div>
    <script is:inline>
      window.onerror = function (msg, url, line, col, error) {
        const overlay = document.getElementById("error-overlay");
        if (overlay) {
          overlay.style.display = "block";
          overlay.innerText = "Error: " + msg + "\nAt: " + url + ":" + line;
        }
        return false;
      };
    </script>
    <script is:inline>
      document.addEventListener("click", function(e) {
        var summary = e.target.closest("summary");
        if (!summary) return;
        var details = summary.parentElement;
        if (!details || details.tagName !== "DETAILS") return;

        e.preventDefault();

        // Prevent overlapping clicks while animating
        if (details.classList.contains("is-animating")) return;
        details.classList.add("is-animating");

        var DURATION = 100; // ms

        // Make sure it doesn't affect standard boxes
        var wasBoxSizing = details.style.boxSizing;
        details.style.boxSizing = "border-box";

        if (details.open) {
          // Collapse
          details.style.overflow = "hidden";
          var startHeight = details.offsetHeight;

          details.removeAttribute("open");
          var endHeight = details.offsetHeight;
          details.setAttribute("open", "");

          details.classList.add("closing"); // Trigger CSS fade out

          details.style.height = startHeight + "px";
          details.offsetHeight; // force reflow

          details.style.transition = "height " + DURATION + "ms ease-out";
          details.style.height = endHeight + "px";

          setTimeout(function() {
            details.removeAttribute("open");
            details.style.height = "";
            details.style.transition = "";
            details.style.overflow = "";
            details.style.boxSizing = wasBoxSizing;
            details.classList.remove("closing");
            details.classList.remove("is-animating");
          }, DURATION);
        } else {
          // Expand
          var startHeight = details.offsetHeight;

          details.setAttribute("open", "");
          var endHeight = details.offsetHeight;
          
          details.style.overflow = "hidden";
          details.style.height = startHeight + "px";
          details.offsetHeight; // force reflow
          
          details.style.transition = "height " + DURATION + "ms ease-out";
          details.style.height = endHeight + "px";
          
          setTimeout(function() {
            details.style.height = "";
            details.style.transition = "";
            details.style.overflow = "";
            details.style.boxSizing = wasBoxSizing;
            details.classList.remove("is-animating");
          }, DURATION);
        }
      });
    </script>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
