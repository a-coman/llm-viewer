!new State('st_shared_welcome_fix')
!st_shared_welcome_fix.name := 'welcome'

!new StateMachine('sm_intakeWorkflowTZ_fix')
!sm_intakeWorkflowTZ_fix.name := 'intakeWorkflowTZ'

