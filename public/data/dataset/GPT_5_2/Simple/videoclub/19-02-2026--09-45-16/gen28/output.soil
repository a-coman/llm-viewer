!insert (instSeries2, instA4) into CassetteActor

!new Rental('instR1')
!instR1.date := Date('1999-06-12')
!insert (instC1, instR1) into ClientRental
!insert (instR1, instTape2) into RentalCassette

!new Rental('instR2')
!instR2.date := Date('1999-06-19')
