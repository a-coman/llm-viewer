!new Client('c1')
!c1.clientId := 1
!c1.isSuspended := false

!new Client('c2')
!c2.clientId := 2
!c2.isSuspended := true

!new Client('c3')
!c3.clientId := 3
!c3.isSuspended := false

!new Movie('m1')
!m1.title := 'Edge of Tomorrow'
!m1.availableCopies := 3
!m1.genre := #Action

!new Movie('m2')
!m2.title := 'City Laughs'
!m2.availableCopies := 1
!m2.genre := #Comedy

!new Movie('m3')
!m3.title := 'Last Stand'
!m3.availableCopies := 0
!m3.genre := #Action

!new Series('s1')
!s1.title := 'Detective Files'
!s1.availableCopies := 2
!s1.episode := 1

!new Series('s2')
!s2.title := 'Detective Files'
!s2.availableCopies := 2
!s2.episode := 2

!new Actor('a1')
