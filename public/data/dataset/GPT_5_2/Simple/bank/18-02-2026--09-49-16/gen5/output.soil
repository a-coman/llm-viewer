!new Bank('bankNO1')
!bankNO1.country := 'Norway'
!bankNO1.name := 'Fjord Finans'
!bankNO1.bic := 'FJFDNO22XXX'

!new Person('s1')
!s1.firstName := 'Isabelle'
!s1.lastName := 'Peeters'
!s1.age := 47

!new Person('s2')
!s2.firstName := 'Thomas'
!s2.lastName := 'Lambert'
!s2.age := 20

!new Person('s3')
!s3.firstName := 'Kari'
!s3.lastName := 'Olsen'
!s3.age := 36

!new Person('s4')
!s4.firstName := 'Milan'
!s4.lastName := 'Novak'
!s4.age := 17

!new Person('s5')
!s5.firstName := 'Amina'
!s5.lastName := 'Hassan'
!s5.age := 63

!new Account('accBEX1')
!accBEX1.iban := 'BE71096123456769'
