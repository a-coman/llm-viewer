!new Account('keAcc1')
!keAcc1.iban := 'KE00NAIB00000000000001'
!keAcc1.balance := 150

!new Account('keAcc2')
!keAcc2.iban := 'KE00NAIB00000000004567'
!keAcc2.balance := 22000

!new Account('keAcc3')
