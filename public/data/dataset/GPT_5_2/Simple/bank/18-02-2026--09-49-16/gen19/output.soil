!new Bank('bankKE1')
!bankKE1.country := 'Kenya'
!bankKE1.name := 'Nairobi Commercial Bank'
!bankKE1.bic := 'NAIBKENA'

!new Bank('bankEG1')
!bankEG1.country := 'Egypt'
!bankEG1.name := 'Cairo Nile Bank'
!bankEG1.bic := 'CNILEGCA'

!new Person('d1')
!d1.firstName := 'Amina'
!d1.lastName := 'Mwangi'
!d1.age := 32

!new Person('d2')
!d2.firstName := 'Joseph'
!d2.lastName := 'Otieno'
!d2.age := 35

!new Person('d3')
