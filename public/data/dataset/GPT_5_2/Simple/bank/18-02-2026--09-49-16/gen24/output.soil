!new Bank('bankNG1')
!bankNG1.country := 'Nigeria'
!bankNG1.name := 'Lagos Union Bank'
!bankNG1.bic := 'LUNBNGLAXXX'

!new Bank('bankPT2')
!bankPT2.country := 'Portugal'
!bankPT2.name := 'Banco do Porto'
!bankPT2.bic := 'BDPOPTPLXXX'

!new Person('g1')
!g1.firstName := 'Adewale'
!g1.lastName := 'Okafor'
!g1.age := 48

!new Person('g2')
!g2.firstName := 'Beatriz'
!g2.lastName := 'Sousa'
!g2.age := 37

!new Person('g3')
