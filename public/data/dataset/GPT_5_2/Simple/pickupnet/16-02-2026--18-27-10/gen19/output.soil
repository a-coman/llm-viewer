!cust_901.name := 'Sabine Krueger'
!cust_901.twitterUserName := 'sabine_krueger'
!insert (st_city_service, cust_901) into StationContainsCustomer

!new Shipment('shp_90001')
!shp_90001.id := 'S-90001'
