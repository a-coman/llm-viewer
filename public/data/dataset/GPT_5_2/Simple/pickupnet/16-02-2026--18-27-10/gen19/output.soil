!geo_addr_dl_city_hotel.latitude := 50.9413
!geo_addr_dl_city_hotel.longitude := 6.9583
!insert (addr_dl_city_hotel, geo_addr_dl_city_hotel) into AddressContainsGeoLocation

!new Address('addr_dl_city_lab')
