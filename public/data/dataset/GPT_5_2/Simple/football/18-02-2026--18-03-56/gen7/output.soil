!pOS_DEF.age := 28
!pOS_DEF.bestFoot := #RIGHT
!pOS_DEF.phoneNumber := '+44 7700 820001'

!insert (teamNW, pNW_MID) into TeamPlayer
!insert (teamOS, pOS_DEF) into TeamPlayer

!new Position('posNW_mid')
!posNW_mid.positionName := #MIDFIELDER
