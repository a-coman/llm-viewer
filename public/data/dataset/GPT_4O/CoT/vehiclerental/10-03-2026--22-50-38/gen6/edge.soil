!officeCoastalEmergencyRentals.address := '120 Shoreline Dr, Harbor Town, FL 33001'

!new Truck('truck12345')
!truck12345.id := 12345
!truck12345.registrationState := #FL
!truck12345.licensePlateNumber := 'FL-987-ZYX'
